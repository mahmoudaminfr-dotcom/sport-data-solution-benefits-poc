        <mxCell id="banner" value="&lt;b style='font-size:18px'&gt;Sport Data Solution — Architecture Cible du Dispositif Avantages Sportifs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#334155'&gt;Lakehouse Médaillon S3 &amp;amp; Streaming CDC Temps Réel sans JVM Python | Confinement RGPD par Construction | Recalcul Budgétaire Sub-Seconde (~130 ms)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontFamily=Segoe UI;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1">
