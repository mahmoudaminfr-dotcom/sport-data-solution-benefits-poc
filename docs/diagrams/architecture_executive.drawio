        <mxCell id="c4_ops" value="&lt;b&gt;Supervision &lt;i&gt;ops_monitoring&lt;/i&gt;&lt;/b&gt;&lt;br&gt;- Historique &lt;i&gt;pipeline_runs&lt;/i&gt; &amp;amp; contrôles Soda&lt;br&gt;- 4 vues SQL analytiques (santé, latence,&lt;br&gt;  volumétrie, SLA fraîcheur batch &lt;b&gt;26 h&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="lane4">
