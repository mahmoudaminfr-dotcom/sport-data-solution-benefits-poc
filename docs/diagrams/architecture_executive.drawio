        <mxCell id="c1_src" value="&lt;b&gt;Référentiels RH &amp;amp; Sport (MinIO S3)&lt;/b&gt;&lt;br&gt;- Données RH : &lt;b&gt;161 salariés&lt;/b&gt; (5 BU)&lt;br&gt;- Déclaratif Sport : &lt;b&gt;95 sportifs actifs&lt;/b&gt;&lt;br&gt;- Bucket brut &lt;i&gt;sds-raw-referentials&lt;/i&gt;&lt;br&gt;- Synchronisation idempotente &lt;i&gt;SHA-256&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="lane1">
          <mxGeometry x="19" y="58" width="270" height="142" as="geometry" />
        </mxCell>
        <mxCell id="c1_maps" value="&lt;b&gt;API Google Maps &amp;amp; Cache RGPD&lt;/b&gt;&lt;br&gt;- Contrôle Domicile -&amp;gt; Siège Lattes&lt;br&gt;- Marche/running &amp;lt;= &lt;b&gt;15 km&lt;/b&gt; | Vélo &amp;lt;= &lt;b&gt;25 km&lt;/b&gt;&lt;br&gt;- Repli routier &lt;i&gt;BAN + OSRM&lt;/i&gt; résilient&lt;br&gt;- Cache salé &lt;i&gt;SHA-256&lt;/i&gt; (68 trajets, 0 PII)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="lane1">
          <mxGeometry x="19" y="232" width="270" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c1_oltp" value="&lt;b&gt;PostgreSQL 16 — OLTP Sportif&lt;/b&gt;&lt;br&gt;- Schéma &lt;i&gt;oltp_sports.sport_activities&lt;/i&gt;&lt;br&gt;- Historique 12 mois : &lt;b&gt;1 723 activités&lt;/b&gt;&lt;br&gt;- 15 disciplines normalisées + &lt;i&gt;live_event&lt;/i&gt;&lt;br&gt;- Réplication WAL : &lt;i&gt;wal_level = logical&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="lane1">
