        <mxCell id="c4_kestra" value="&lt;b&gt;Orchestration Kestra 2.0&lt;/b&gt;&lt;br&gt;- Flow &lt;i&gt;sds.benefits/daily_benefits_pipeline&lt;/i&gt;&lt;br&gt;- Planification Cron &lt;i&gt;06:00 Europe/Paris&lt;/i&gt;&lt;br&gt;- Exécution séquentielle 6 étapes isolées&lt;br&gt;- Alerte Slack automatique sur incident" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="lane4">
