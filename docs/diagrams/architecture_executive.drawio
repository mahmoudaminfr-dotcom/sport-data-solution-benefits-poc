        <mxCell id="c4_soda" value="&lt;b&gt;Portail Qualité Automatisé&lt;/b&gt;&lt;br&gt;- &lt;b&gt;Soda Core 3.5&lt;/b&gt; : &lt;b&gt;22/22&lt;/b&gt; contrats SodaCL&lt;br&gt;  &lt;i&gt;PASS&lt;/i&gt; sur &lt;b&gt;4 096 lignes&lt;/b&gt; évaluées&lt;br&gt;- &lt;b&gt;Pytest&lt;/b&gt; : &lt;b&gt;36/36&lt;/b&gt; tests unitaires hors-ligne&lt;br&gt;  passants (&lt;b&gt;87 %&lt;/b&gt; de couverture &lt;i&gt;src/&lt;/i&gt;)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="lane4">
