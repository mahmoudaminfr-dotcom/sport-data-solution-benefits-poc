        </mxCell>
        <mxCell id="c1_rgpd" value="&lt;b&gt;Cloisonnement RGPD (&lt;i&gt;hr_restricted&lt;/i&gt;)&lt;/b&gt;&lt;br&gt;- Salaires (&lt;b&gt;8,12 M EUR&lt;/b&gt;) &amp;amp; adresses isolés&lt;br&gt;- Quarantaine : &lt;b&gt;1 anomalie&lt;/b&gt; exclue&lt;br&gt;- Rôle dédié &lt;i&gt;sds_pipeline&lt;/i&gt; uniquement" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lane1">
