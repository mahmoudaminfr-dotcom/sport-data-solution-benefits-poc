        <mxCell id="c2_rp" value="&lt;b&gt;Broker Redpanda &amp;amp; Console&lt;/b&gt;&lt;br&gt;- Bus streaming Kafka-compatible&lt;br&gt;- Topic : &lt;i&gt;sds.oltp_sports.sport_activities&lt;/i&gt;&lt;br&gt;- Découplage producteur / consommateur&lt;br&gt;- Supervision temps réel port 8080" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D97706;" vertex="1" parent="lane2">
          <mxGeometry x="19" y="420" width="270" height="185" as="geometry" />
        </mxCell>
        <mxCell id="c3_slack" value="&lt;b&gt;Voie A — Émulation Slack Temps Réel&lt;/b&gt;&lt;br&gt;- Worker Python &lt;i&gt;confluent-kafka&lt;/i&gt;&lt;br&gt;- Coupe-circuit anti-spam sur historique&lt;br&gt;  (&lt;i&gt;op='r'&lt;/i&gt; &amp;amp; &lt;i&gt;historical_seed&lt;/i&gt; ignorés)&lt;br&gt;- Canal &lt;i&gt;#defis-sportifs-sds&lt;/i&gt; + mode &lt;i&gt;dry_run&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="lane3">
          <mxGeometry x="19" y="68" width="270" height="185" as="geometry" />
        </mxCell>
        <mxCell id="c3_lh" value="&lt;b&gt;Voie B — Lakehouse Delta Lake (MinIO S3)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Polars 2.1 + DuckDB 2.0 (arro3) + deltalake 1.6&lt;/i&gt;&lt;br&gt;&lt;br&gt;- &lt;b&gt;Bronze (&lt;i&gt;sds-bronze&lt;/i&gt;)&lt;/b&gt; : pseudonymisation&lt;br&gt;  salée &lt;i&gt;employee_key&lt;/i&gt; dès l'entrée (0 PII)&lt;br&gt;- &lt;b&gt;Silver (&lt;i&gt;sds-silver&lt;/i&gt;)&lt;/b&gt; : nettoyage, typage,&lt;br&gt;  normalisation &lt;i&gt;Runing -&amp;gt; Course à pied&lt;/i&gt;&lt;br&gt;- &lt;b&gt;Gold (&lt;i&gt;sds-gold&lt;/i&gt;)&lt;/b&gt; : 4 tables agrégées&lt;br&gt;  recalculées en &lt;b&gt;~130 ms&lt;/b&gt; côté moteur" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="lane3">
