        <mxCell id="c2_deb" value="&lt;b&gt;Debezium Connect 2.7&lt;/b&gt;&lt;br&gt;- Capture différentielle &lt;i&gt;pgoutput&lt;/i&gt;&lt;br&gt;- Publication &lt;i&gt;sds_activities_pub&lt;/i&gt;&lt;br&gt;- &lt;i&gt;REPLICA IDENTITY FULL&lt;/i&gt;&lt;br&gt;- Rôle &lt;i&gt;sds_debezium&lt;/i&gt; confiné hors RH" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D97706;" vertex="1" parent="lane2">
