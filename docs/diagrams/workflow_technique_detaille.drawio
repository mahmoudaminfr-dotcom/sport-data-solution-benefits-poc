        <mxCell id="w1_cfg" value="&lt;b&gt;1.1 Paramètres Métier &amp;amp; Isolation Git&lt;/b&gt;&lt;br&gt;- &lt;i&gt;config/business_rules.yaml&lt;/i&gt; : prime = &lt;b&gt;5 %&lt;/b&gt;,&lt;br&gt;  plafonds &lt;b&gt;15 / 25 km&lt;/b&gt;, bien-être = &lt;b&gt;5 j&lt;/b&gt; (&amp;gt;= 15 séances)&lt;br&gt;- &lt;i&gt;.gitignore&lt;/i&gt; : blocage strict &lt;i&gt;*.xlsx&lt;/i&gt;, &lt;i&gt;.env&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;data/cache/*&lt;/i&gt; et &lt;i&gt;deliverables_export/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#475569;" vertex="1" parent="w_lane1">
          <mxGeometry x="21" y="65" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w1_pyd" value="&lt;b&gt;1.2 Validation Typée Pydantic&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/settings.py&lt;/i&gt; (&lt;i&gt;BusinessRules&lt;/i&gt;, &lt;i&gt;EnvSettings&lt;/i&gt;)&lt;br&gt;- Contrôle disjonction modes éligibles / non éligibles&lt;br&gt;- Catalogue de &lt;b&gt;15 sports&lt;/b&gt; (avec vs sans distance)&lt;br&gt;- Détection automatique des secrets modèles" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#475569;" vertex="1" parent="w_lane1">
          <mxGeometry x="21" y="295" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w1_rbac" value="&lt;b&gt;1.3 Cloisonnement SQL RGPD (PostgreSQL 16)&lt;/b&gt;&lt;br&gt;- &lt;i&gt;docker/postgres/01_init_platform.sh&lt;/i&gt;&lt;br&gt;- 4 schémas : &lt;i&gt;hr_restricted&lt;/i&gt;, &lt;i&gt;oltp_sports&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;gold_mart&lt;/i&gt;, &lt;i&gt;ops_monitoring&lt;/i&gt;&lt;br&gt;- 3 rôles : &lt;i&gt;sds_pipeline&lt;/i&gt;, &lt;i&gt;sds_debezium&lt;/i&gt;, &lt;i&gt;sds_bi_reader&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#475569;" vertex="1" parent="w_lane1">
          <mxGeometry x="21" y="530" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="w1_gate1" value="&lt;b&gt;[PORTE DE CONTRÔLE 1 — Suite Pytest &amp;amp; Ruff]&lt;/b&gt;&lt;br&gt;- &lt;b&gt;36/36 tests unitaires hors-ligne&lt;/b&gt; passants&lt;br&gt;- Couverture &lt;b&gt;87 %&lt;/b&gt; sur &lt;i&gt;src/&lt;/i&gt; (mocks HTTP/S3/SQL)&lt;br&gt;- Isolation stricte &lt;i&gt;os.environ&lt;/i&gt; &amp;amp; lazy-load natif&lt;br&gt;- Linter &lt;i&gt;ruff check .&lt;/i&gt; : &lt;b&gt;0 erreur&lt;/b&gt; (code + &lt;i&gt;.ipynb&lt;/i&gt;)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2.2;" vertex="1" parent="w_lane1">
          <mxGeometry x="21" y="775" width="350" height="245" as="geometry" />
        </mxCell>
        <mxCell id="w2_xlsx" value="&lt;b&gt;2.1 Fichiers Sources Entreprise&lt;/b&gt;&lt;br&gt;- &lt;i&gt;Données RH.xlsx&lt;/i&gt; : &lt;b&gt;161 lignes&lt;/b&gt;, 11 colonnes,&lt;br&gt;  68 déclarations de mobilité active à auditer&lt;br&gt;- &lt;i&gt;Données Sportive.xlsx&lt;/i&gt; : &lt;b&gt;161 ID&lt;/b&gt; (jointure 1:1),&lt;br&gt;  95 sports déclarés (coquille &lt;i&gt;Runing&lt;/i&gt; détectée)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#2563EB;" vertex="1" parent="w_lane2">
          <mxGeometry x="21" y="65" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w2_s3" value="&lt;b&gt;2.2 Synchronisation Idempotente MinIO S3&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/ingestion/minio_loader.py&lt;/i&gt;&lt;br&gt;- Provisionnement des 4 buckets Lakehouse&lt;br&gt;- Résolution Unicode NFC/NFD sous Windows NTFS&lt;br&gt;- Dépôt contrôlé par métadonnée &lt;i&gt;sha256&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#2563EB;" vertex="1" parent="w_lane2">
          <mxGeometry x="21" y="295" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w2_maps" value="&lt;b&gt;2.3 Audit Géospatial Domicile -&amp;gt; Siège Lattes&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/ingestion/commute_distance.py&lt;/i&gt;&lt;br&gt;- Primaire : &lt;i&gt;Google Maps Distance Matrix API&lt;/i&gt;&lt;br&gt;- Repli automatique : &lt;i&gt;API Adresse (BAN) + OSRM&lt;/i&gt;&lt;br&gt;- Cache &lt;i&gt;SHA-256&lt;/i&gt; salé : &lt;b&gt;68 entrées&lt;/b&gt; (0 adresse)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#2563EB;" vertex="1" parent="w_lane2">
          <mxGeometry x="21" y="530" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="w2_gate2" value="&lt;b&gt;[PORTE DE CONTRÔLE 2 — Filtre Maps &amp;amp; Quarantaine]&lt;/b&gt;&lt;br&gt;- Marche/running &amp;lt;= 15 km : &lt;b&gt;14 éligibles&lt;/b&gt; validés&lt;br&gt;- Vélo/Trottinette &amp;lt;= 25 km : &lt;b&gt;53 éligibles&lt;/b&gt; validés&lt;br&gt;- Budget prime validé (5 %) : &lt;b&gt;168 824,50 EUR&lt;/b&gt;&lt;br&gt;- Quarantaine RH : &lt;b&gt;1 anomalie&lt;/b&gt; (sans code postal)&lt;br&gt;  isolée et exclue du calcul budgétaire" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2.2;" vertex="1" parent="w_lane2">
          <mxGeometry x="21" y="775" width="350" height="245" as="geometry" />
        </mxCell>
        <mxCell id="w3_oltp" value="&lt;b&gt;3.1 Seeding OLTP 12 Mois &amp;amp; CLI Live&lt;/b&gt;&lt;br&gt;- &lt;i&gt;postgres_generator.py&lt;/i&gt; &amp;amp; &lt;i&gt;inject_live_activity.py&lt;/i&gt;&lt;br&gt;- &lt;i&gt;hr_restricted.employees_audit&lt;/i&gt; : &lt;b&gt;161 salariés&lt;/b&gt;&lt;br&gt;- &lt;i&gt;oltp_sports.sport_activities&lt;/i&gt; : &lt;b&gt;1 723 séances&lt;/b&gt;&lt;br&gt;  (0 avant &lt;i&gt;hire_date&lt;/i&gt;, &lt;i&gt;distance_m = NULL&lt;/i&gt; hors endurance)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#D97706;" vertex="1" parent="w_lane3">
          <mxGeometry x="21" y="65" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w3_cdc" value="&lt;b&gt;3.2 Capture CDC Debezium -&amp;gt; Redpanda&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/streaming/debezium_connector.py&lt;/i&gt;&lt;br&gt;- Connecteur REST &lt;i&gt;sds-postgres-activities-cdc&lt;/i&gt;&lt;br&gt;- Slot logique &lt;i&gt;sds_activities_debezium&lt;/i&gt; (&lt;i&gt;pgoutput&lt;/i&gt;)&lt;br&gt;- Topic Redpanda : &lt;i&gt;sds.oltp_sports.sport_activities&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#D97706;" vertex="1" parent="w_lane3">
          <mxGeometry x="21" y="300" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w3_gate3" value="&lt;b&gt;[PORTE DE CONTRÔLE 3 — RGPD CDC &amp;amp; Anti-Spam]&lt;/b&gt;&lt;br&gt;- Vérification d'absence totale de droit de&lt;br&gt;  &lt;i&gt;sds_debezium&lt;/i&gt; sur le schéma &lt;i&gt;hr_restricted&lt;/i&gt;&lt;br&gt;- Double coupe-circuit &lt;i&gt;cdc_consumer.py&lt;/i&gt; :&lt;br&gt;  filtrage 100 % &lt;i&gt;op='r'&lt;/i&gt; &amp;amp; &lt;i&gt;historical_seed&lt;/i&gt; (0 spam)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2.2;" vertex="1" parent="w_lane3">
          <mxGeometry x="21" y="535" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="w3_slack" value="&lt;b&gt;3.3 Notification Temps Réel Slack&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/streaming/slack_notifier.py&lt;/i&gt;&lt;br&gt;- Messages personnalisés français (sans emoji)&lt;br&gt;  avec ou sans distance selon la discipline&lt;br&gt;- Retries HTTP 429/5xx et bascule &lt;i&gt;dry_run&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#D97706;" vertex="1" parent="w_lane3">
          <mxGeometry x="21" y="795" width="350" height="225" as="geometry" />
        </mxCell>
        <mxCell id="w4_brz" value="&lt;b&gt;4.1 Couche Delta Lake Bronze (Minimisation)&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/processing/lakehouse_bronze_silver.py&lt;/i&gt;&lt;br&gt;- Tables S3 : &lt;i&gt;employees_audit&lt;/i&gt;, &lt;i&gt;sport_activities&lt;/i&gt;&lt;br&gt;- Hachage salé &lt;i&gt;employee_key&lt;/i&gt;, &lt;i&gt;birth_year&lt;/i&gt; seul,&lt;br&gt;  booléen &lt;i&gt;has_comment&lt;/i&gt; -&amp;gt; &lt;b&gt;0 colonne PII exposée&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#16A34A;" vertex="1" parent="w_lane4">
          <mxGeometry x="21" y="65" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w4_slv" value="&lt;b&gt;4.2 Couche Delta Lake Silver (Qualification)&lt;/b&gt;&lt;br&gt;- Tables S3 : &lt;i&gt;employees_cleansed&lt;/i&gt; (161),&lt;br&gt;  &lt;i&gt;sport_activities_enriched&lt;/i&gt; (1 723 valides)&lt;br&gt;- Correction &lt;i&gt;Runing -&amp;gt; Course à pied&lt;/i&gt; (15 sports)&lt;br&gt;- Contrôle cohérence durées, dates UTC et distances" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#16A34A;" vertex="1" parent="w_lane4">
          <mxGeometry x="21" y="300" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w4_gld" value="&lt;b&gt;4.3 Couche Gold &amp;amp; Sync &lt;i&gt;gold_mart&lt;/i&gt; (~130 ms)&lt;/b&gt;&lt;br&gt;- &lt;i&gt;lakehouse_gold.py&lt;/i&gt; &amp;amp; &lt;i&gt;recompute_gold_kpis.py&lt;/i&gt;&lt;br&gt;- Moteur &lt;i&gt;DuckDB 2.0 + Polars 2.1&lt;/i&gt; via &lt;i&gt;arro3&lt;/i&gt;&lt;br&gt;- 4 tables S3 &lt;i&gt;sds-gold&lt;/i&gt; + 5 tables SQL &lt;i&gt;gold_mart&lt;/i&gt;&lt;br&gt;  (&lt;i&gt;fact_employee_benefits&lt;/i&gt;, BU, mensuel, snapshot)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#16A34A;" vertex="1" parent="w_lane4">
          <mxGeometry x="21" y="535" width="350" height="200" as="geometry" />
        </mxCell>
        <mxCell id="w4_gate4" value="&lt;b&gt;[PORTE DE CONTRÔLE 4 — Contrats Soda Core 3.5]&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/quality/soda_runner.py&lt;/i&gt; (&lt;i&gt;checks_pipeline.yml&lt;/i&gt;)&lt;br&gt;- &lt;b&gt;22/22 contrôles SodaCL PASS&lt;/b&gt; sur &lt;b&gt;4 096 lignes&lt;/b&gt;&lt;br&gt;  (&lt;i&gt;hr_audit&lt;/i&gt;: 6 | &lt;i&gt;bronze&lt;/i&gt;: 4 | &lt;i&gt;silver&lt;/i&gt;: 7 | &lt;i&gt;gold&lt;/i&gt;: 5)&lt;br&gt;- Réconciliation au centime &amp;amp; 0 prime sur anomalie&lt;br&gt;- Historisation &lt;i&gt;ops_monitoring.quality_check_results&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2.2;" vertex="1" parent="w_lane4">
          <mxGeometry x="21" y="785" width="350" height="235" as="geometry" />
        </mxCell>
        <mxCell id="w5_kestra" value="&lt;b&gt;5.1 Orchestration Quotidienne Kestra 2.0&lt;/b&gt;&lt;br&gt;- &lt;i&gt;flows/daily_benefits_pipeline.yml&lt;/i&gt;&lt;br&gt;- Déploiement REST idempotent (&lt;i&gt;CREATED/UPDATED&lt;/i&gt;)&lt;br&gt;- Cron &lt;i&gt;06:00 Europe/Paris&lt;/i&gt; (&lt;i&gt;concurrency: 1&lt;/i&gt;)&lt;br&gt;- 6 tâches séquentielles Process + bloc &lt;i&gt;errors&lt;/i&gt; Slack" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#0284C7;" vertex="1" parent="w_lane5">
          <mxGeometry x="21" y="65" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w5_ops" value="&lt;b&gt;5.2 Consolidation Continue &lt;i&gt;ops_monitoring&lt;/i&gt;&lt;/b&gt;&lt;br&gt;- &lt;i&gt;src/monitoring/pipeline_monitor.py&lt;/i&gt;&lt;br&gt;- 4 vues SQL analytiques : &lt;i&gt;v_pipeline_health_summary&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;v_layer_freshness_status&lt;/i&gt;, &lt;i&gt;v_quality_latest_checks&lt;/i&gt;,&lt;br&gt;  &lt;i&gt;v_quality_layer_summary&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#0284C7;" vertex="1" parent="w_lane5">
          <mxGeometry x="21" y="300" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w5_gate5" value="&lt;b&gt;[PORTE DE CONTRÔLE 5 — SLA 26 h &amp;amp; RBAC BI]&lt;/b&gt;&lt;br&gt;- Évaluation globale &lt;i&gt;HEALTHY / DEGRADED / CRITICAL&lt;/i&gt;&lt;br&gt;  sur le dernier run et le SLA fraîcheur &lt;b&gt;26 h&lt;/b&gt;&lt;br&gt;- Audit RBAC : &lt;i&gt;sds_bi_reader&lt;/i&gt; limité en &lt;i&gt;SELECT&lt;/i&gt; à&lt;br&gt;  &lt;i&gt;gold_mart&lt;/i&gt; &amp;amp; &lt;i&gt;ops_monitoring&lt;/i&gt; (&lt;i&gt;42501&lt;/i&gt; ailleurs)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2.2;" vertex="1" parent="w_lane5">
          <mxGeometry x="21" y="535" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="w5_bi" value="&lt;b&gt;5.3 Power BI (&lt;i&gt;.pbix&lt;/i&gt;) &amp;amp; Recette Section 6&lt;/b&gt;&lt;br&gt;- Connexion PostgreSQL &lt;i&gt;127.0.0.1:5433&lt;/i&gt; (&lt;i&gt;sds_bi_reader&lt;/i&gt;)&lt;br&gt;- KPI exécutifs (&lt;b&gt;168 824,50 EUR&lt;/b&gt; | &lt;b&gt;245 jours&lt;/b&gt;),&lt;br&gt;  ventilation BU / sports, anomalies &amp;amp; supervision&lt;br&gt;- Simulation budgétaire What-If DAX &amp;amp; notebook &lt;i&gt;.ipynb&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeWidth=1.5;strokeColor=#0284C7;" vertex="1" parent="w_lane5">
