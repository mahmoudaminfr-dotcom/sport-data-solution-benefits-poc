# ==============================================================================
# Sport Data Solution - Configuration Environnement (Modele sans secrets reels)
# Copier ce fichier vers .env et renseigner les secrets locaux avant execution.
# ==============================================================================

# --- PostgreSQL 16 (Transactionnel OLTP, CDC WAL logique et Data Mart Gold) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sds_platform
POSTGRES_ADMIN_USER=sds_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_secret

# Roles applicatifs cloisonnes (principe de moindre privilege RGPD)
SDS_PIPELINE_USER=sds_pipeline
SDS_PIPELINE_PASSWORD=change_me_pipeline_secret
SDS_DEBEZIUM_USER=sds_debezium
SDS_DEBEZIUM_PASSWORD=change_me_debezium_secret
SDS_BI_READER_USER=sds_bi_reader
SDS_BI_READER_PASSWORD=change_me_bi_reader_secret

# --- Stockage Objet S3 Compatible (MinIO) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=sds_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_REGION=eu-west-3
MINIO_BUCKET_RAW=sds-raw-referentials
MINIO_BUCKET_BRONZE=sds-bronze
MINIO_BUCKET_SILVER=sds-silver
MINIO_BUCKET_GOLD=sds-gold

# --- Streaming Temps Reel (Redpanda & Debezium Connect) ---
REDPANDA_BROKERS=localhost:19092
REDPANDA_CONSOLE_PORT=8080
DEBEZIUM_CONNECT_URL=http://localhost:8083
REDPANDA_ACTIVITY_TOPIC=sds.oltp_sports.sport_activities

# --- API Externe Google Maps (Audit des distances domicile-travail) ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Integration Slack (Publication automatique des activites sportives) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_CHANNEL_NAME=#defis-sportifs-sds
SLACK_NOTIFICATIONS_ENABLED=true

# --- Securite & Pseudonymisation RGPD ---
SDS_PII_HASH_SALT=change_me_random_32_chars_salt_value